/**
 * Student
 *
 * Comprehensive domain entity representing enrolled students in a school branch.
 * Links optionally 1:1 with User (when login account is provisioned/approved).
 * Belongs directly to Branch (which belongs to Organization).
 *
 * Features:
 * - Complete admission lifecycle (Draft -> Submitted -> Approved/Rejected)
 * - Academic identifiers (enrollmentNo, applicationNo)
 * - Comprehensive demographics & government IDs (Aadhaar, APAAR)
 * - Detailed contact & residential address
 * - Previous education records (10th & 12th standards)
 * - Family & Guardian details (Father, Mother, Local Guardian)
 * - Document storage metadata (JSON URLs/keys for cloud storage)
 * - Many-to-Many StudentParentRelation mapping
 */

/// Gender identification for students.
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Lifecycle states for an admission application.
enum AdmissionStatus {
  DRAFT
  SUBMITTED
  PENDING_PAYMENT
  APPROVED
  REJECTED
}

model Student {
  id                  String          @id @default(uuid()) @db.Uuid

  // Foreign key to Branch
  branchId            String          @db.Uuid
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // 1:1 Link to User credentials (optional until admission is approved & user created)
  userId              String?         @unique @db.Uuid
  user                User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identification Numbers
  enrollmentNo        String?         @unique // Generated after admission approval
  applicationNo       String?         @unique // From admission form e.g., APP2026001

  // Personal Info
  firstName           String
  middleName          String?
  lastName            String
  dateOfBirth         DateTime
  gender              Gender          @default(MALE)
  bloodGroup          String?         @db.VarChar(5)
  category            String?
  religion            String?
  nationality         String          @default("Indian")

  aadharNumber        String?
  apaarNumber         String?

  // Contact
  phone               String
  altPhone            String?
  whatsappNumber      String?
  email               String?

  // Address
  streetAddress       String?         @db.Text
  city                String
  state               String
  district            String?
  pincode             String          @db.VarChar(10)
  country             String          @default("India")

  // Academic
  admissionDate       DateTime        @default(now())
  academicYear        String?

  // Previous Education - 10th Standard
  tenthSchoolName     String?
  tenthBoard          String?
  tenthYearOfPassing  Int?
  tenthPercentage     String?
  tenthRollNo         String?
  tenthSubjects       String?

  // Previous Education - 12th Standard
  twelfthSchoolName   String?
  twelfthBoard        String?
  twelfthYearOfPassing Int?
  twelfthPercentage   String?
  twelfthStream       String?
  twelfthSubjects     String?

  // Father's Details
  fatherName          String?
  fatherOccupation    String?
  fatherPhone         String?
  fatherEmail         String?
  fatherAnnualIncome  String?

  // Mother's Details
  motherName          String?
  motherOccupation    String?
  motherPhone         String?

  // Local Guardian Details
  localGuardianName     String?
  localGuardianRelation String?
  localGuardianPhone    String?
  localGuardianAddress  String?       @db.Text

  // Uploaded Documents (Cloud storage metadata)
  photo               Json?
  aadharFront         Json?
  aadharBack          Json?
  tenthMarksheet      Json?
  twelfthMarksheet    Json?
  transferCertificate Json?
  apaarCard           Json?
  casteCertificate    Json?
  admissionForm       Json?

  // Status & Lifecycle
  admissionStatus     AdmissionStatus @default(DRAFT)
  isActive            Boolean         @default(true)

  /* Timestamps */
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?                                     // Soft delete

  /* Relations */
  parents                 StudentParentRelation[]
  branchAcademicSessionId String?                 @db.Uuid
  branchAcademicSession   BranchAcademicSession?  @relation(fields: [branchAcademicSessionId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([userId])
  @@index([branchAcademicSessionId])
  @@index([admissionStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@map("students")
}
