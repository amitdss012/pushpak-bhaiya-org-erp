/**
 * Organization
 *
 * Top-level tenant entity. Every branch, user, role,
 * and subscription belongs to exactly one organization.
 *
 * The slug field provides a URL-safe unique identifier
 * (e.g., "acme-corp") used in API routes and panel URLs.
 *
 * Soft-deleted via deletedAt — never hard-delete an
 * org to preserve audit trails and billing history.
 */

/// Lifecycle states for an organization.
enum OrgStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique                             // URL-safe: "acme-corp"
  email     String?
  phone     String?

  /* Branding & Address */
  logo      String?                                       // URL to uploaded logo
  address   String?
  city      String?
  state     String?
  country   String?   @default("IN") @db.VarChar(2)       // ISO 3166-1 alpha-2
  pincode   String?   @db.VarChar(10)

  status    OrgStatus @default(ACTIVE)

  /* Timestamps */
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?                                     // soft delete

  /* Relations */
  branches          Branch[]
  users             User[]
  roles             Role[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  academicSessions  AcademicSession[]

  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

/**
 * AcademicSession
 *
 * Master academic session defined at Organization level.
 * Single source of truth for session duration, naming, and years.
 * Can be created by Organization users or Branch users (tracked via createdBy).
 */
model AcademicSession {
  id              String          @id @default(uuid()) @db.Uuid

  organizationId  String          @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String          // e.g., "2025-2026"
  code            String?         // e.g., "AY-2025-26"
  startYear       Int             // 2025
  endYear         Int             // 2026
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  description     String?         @db.Text

  createdById     String?         @db.Uuid
  createdBy       User?           @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  // Mapping to branches
  branchMappings  BranchAcademicSession[]

  @@unique([organizationId, name, deletedAt])
  @@index([organizationId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("academic_sessions")
}

/**
 * BranchAcademicSession
 *
 * Normalized mapping connecting an AcademicSession with a Branch.
 * Contains isCurrent to track which session is active for this branch.
 * Stores createdBy to track which user created/mapped this session for the branch.
 */
model BranchAcademicSession {
  id                  String          @id @default(uuid()) @db.Uuid

  academicSessionId   String          @db.Uuid
  academicSession     AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  branchId            String          @db.Uuid
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isCurrent           Boolean         @default(false) // Current active session for this branch

  createdById         String?         @db.Uuid
  createdBy           User?           @relation("BranchSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  students            Student[]

  @@unique([branchId, academicSessionId, deletedAt])
  @@index([branchId])
  @@index([academicSessionId])
  @@index([isCurrent])
  @@index([createdById])
  @@index([deletedAt])
  @@map("branch_academic_sessions")
}

