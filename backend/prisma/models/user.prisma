// ============================================
// User — Unified authentication for all users
// ============================================

model User {
  id              String    @id @default(cuid())

  // Type & Identity
  userType        UserType
  name            String
  email           String    @unique
  phone           String?   @unique
  username        String    @unique
  password        String    @db.Text                     // Always store hashed
  avatar          Json?

  // Status & Audit
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization?
  branch          Branch?
  student         Student?

  @@index([userType])
  @@map("users")
}

enum UserType {
  ORGANIZATION
  BRANCH
  STUDENT
}